# Browser-visible values only. Anything prefixed NEXT_PUBLIC_ is exposed to the client bundle.
NEXT_PUBLIC_STELLAR_NETWORK=local
# NEXT_PUBLIC_STELLAR_RPC_URL=
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
# NEXT_PUBLIC_CONTRACT_ID=

# Server-only examples (never expose with NEXT_PUBLIC_):
# DATABASE_URL=
# AUTH_SECRET=
# WEBHOOK_SECRET=
# STELLAR_SERVER_SECRET=

# Provider credentials remain server-only and are registered conditionally.
# COINS_PH_FIRM_QUOTES_ENABLED=false
# COINS_PH_API_KEY=
# COINS_PH_SECRET_KEY=
# COINS_PH_BANK_SUBJECT=
# COINS_PH_QUOTE_ACCESS_TOKEN=
# COINS_PH_QUOTE_RATE_LIMIT_PER_MINUTE=10
# ONRAMPER_API_KEY=
# ONRAMPER_ENVIRONMENT=staging
# ONRAMPER_XLM_TESTNET_ASSET_ID=
# ONRAMPER_USDC_TESTNET_ASSET_ID=
