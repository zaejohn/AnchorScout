# Public Stellar Testnet configuration. These values are exposed to the browser.
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_ROUTE_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_SETTLEMENT_RECEIPT_CONTRACT_ID=
NEXT_PUBLIC_ROUTE_EXECUTOR_CONTRACT_ID=
NEXT_PUBLIC_PROOF_PAYMENT_DESTINATION=
NEXT_PUBLIC_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional server-only indicative SEP-38 provider.
SEP38_ANCHOR_HOME_DOMAIN=
SEP38_ANCHOR_NAME=
SEP38_ALLOWED_QUOTE_ORIGINS=
TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional server-only production provider data. Anonymous requests always use
# the public market reference. Firm data requires a separate trusted bearer.
COINS_PH_FIRM_QUOTES_ENABLED=false
COINS_PH_API_KEY=
COINS_PH_SECRET_KEY=
# Required only for BANK requests; use the provider's live transactionSubject.
COINS_PH_BANK_SUBJECT=
# At least 32 random characters. Never expose this token to the browser.
COINS_PH_QUOTE_ACCESS_TOKEN=
COINS_PH_QUOTE_RATE_LIMIT_PER_MINUTE=10

# Optional Onramper aggregator. Register only asset IDs that Onramper has
# explicitly provisioned for Stellar Testnet; generic/Mainnet IDs are rejected.
ONRAMPER_API_KEY=
ONRAMPER_ENVIRONMENT=staging
ONRAMPER_XLM_TESTNET_ASSET_ID=
ONRAMPER_USDC_TESTNET_ASSET_ID=

# Server-only automation; use an external durable Postgres database on Vercel.
DATABASE_URL=
# At least 32 random characters. cron-job.org sends Authorization: Bearer <value>.
CRON_SECRET=
# Exactly 32 random bytes encoded as base64. Keep stable while any run is active.
SIMULATION_WALLET_KEY=
